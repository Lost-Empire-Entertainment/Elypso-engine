//Build script for use with kalamake. Read more at https://github.com/kalakit/kalamake

#version 1.0

#references
name_bin: elypsoengine
dir_release: build/release-
dir_debug: build/debug-

links_win_deb: "${dir_kw_deb}/${name_kw}d.lib", "${dir_kg_deb}/${name_kg}d.lib", "${dir_kp_deb}/${name_kp}d.lib", "${dir_ka_deb}/${name_ka}d.lib", "${dir_kl_deb}/${name_kl}d.lib", "${dir_l_deb}/${name_l}d.lib", "${dir_sp_deb}/${name_sp}.lib"
links_win_rel: "${dir_kw_rel}/${name_kw}.lib", "${dir_kg_rel}/${name_kg}.lib", "${dir_kp_rel}/${name_kp}.lib", "${dir_ka_rel}/${name_ka}.lib", "${dir_kl_rel}/${name_kl}.lib", "${dir_l_rel}/${name_l}.lib", "${dir_sp_rel}/${name_sp}.lib"
links_lin_deb: "${dir_kw_deb}/lib${name_kw}d.a", "${dir_kg_deb}/lib${name_kg}d.a", "${dir_kp_deb}/lib${name_kp}d.a", "${dir_ka_deb}/lib${name_ka}d.a", "${dir_kl_deb}/lib${name_kl}d.a", "${dir_l_deb}/lib${name_l}d.a", "${dir_sp_deb}/lib${name_sp}d.a"
links_lin_rel: "${dir_kw_rel}/lib${name_kw}.a", "${dir_kg_rel}/lib${name_kg}.a", "${dir_kp_rel}/lib${name_kp}.a", "${dir_ka_rel}/lib${name_ka}.a", "${dir_kl_rel}/lib${name_kl}.a", "${dir_l_rel}/lib${name_l}.a", "${dir_sp_rel}/lib${name_sp}.a"

//
// KALAWINDOW
//
name_kw: kalawindow
dir_kw_rel: ../../external-shared/KalaWindow/release
dir_kw_deb: ../../external-shared/KalaWindow/debug
//
// KALAGRAPHICS
//
name_kg: kalagraphics
dir_kg_rel: ../../external-shared/KalaGraphics/release
dir_kg_deb: ../../external-shared/KalaGraphics/debug
//
// KALAPHYSICS
//
name_kp: kalaphysics
dir_kp_rel: ../../external-shared/KalaPhysics/release
dir_kp_deb: ../../external-shared/KalaPhysics/debug
//
// KALAAUDIO
//
name_ka: kalaaudio
dir_ka_rel: ../../external-shared/KalaAudio/release
dir_ka_deb: ../../external-shared/KalaAudio/debug
//
// KALALUA
//
name_kl: kalalua
dir_kl_rel: ../../external-shared/KalaLua/release
dir_kl_deb: ../../external-shared/KalaLua/debug
//
// LUA
//
name_l: lua
dir_l_rel: ../../external-shared/lua/release
dir_l_deb: ../../external-shared/lua/debug
//
// SPIRV-REFLECT
//
name_sp: spirv-reflect
dir_sp_rel: ../../external-shared/Spirv-reflect/release
dir_sp_deb: ../../external-shared/Spirv-reflect/debug

#global
compilerlauncher: ccache
compiler: clang++
standard: c++20
binarytype: static
sources: "src"
headers: "include", "../../external-shared/KalaHeaders", "../../external-shared/KalaWindow/include", "../../external-shared/KalaGraphics/include", "../../external-shared/KalaPhysics/include", "../../external-shared/KalaAudio/include", "../../external-shared/KalaLua/include", "../../external-shared/lua/include", "../../external-shared/Vulkan/Include", "../../external-shared/Spirv-reflect"
defines: LIB_STATIC
warninglevel: normal
customflags: export-compile-commands, export-vscode-sln

#profile debug-windows
binaryname: ${name_bin}d
buildtype: debug
buildpath: "${dir_debug}windows"
links: ${links_win_deb}

#profile release-windows
binaryname: ${name_bin}
buildtype: minsizerel
buildpath: "${dir_release}windows"
//customflags: generate-symbols
links: ${links_win_rel}

#profile debug-linux
binaryname: lib${name_bin}d
buildtype: debug
buildpath: "${dir_debug}linux"
links: ${links_lin_deb}

#profile release-linux
binaryname: lib${name_bin}
buildtype: minsizerel
buildpath: "${dir_release}linux"
links: ${links_lin_deb}
postbuildaction: strip --strip-unneeded ${dir_release}linux/lib${name_bin}.a
